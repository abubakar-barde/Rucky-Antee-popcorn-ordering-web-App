# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Backend Configuration (Browser-safe Public Client)
# Obtain these from your Supabase Project Settings -> API
# Use the Project URL and Public Publishable / Anon Key.
# DO NOT provide SUPABASE_SECRET_KEY, service_role, or SUPABASE_SERVICE_ROLE_KEY here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-public-key"
# Also compatible with VITE_ prefixed equivalents:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-public-key"

# Paystack Public Key (for online debit/credit card payments)
# Test key format: pk_test_xxxx... | Live key format: pk_live_xxxx...
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
